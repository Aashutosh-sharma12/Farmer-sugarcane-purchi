# MongoDB Atlas connection string (Atlas > Connect > Drivers). Include the database name, e.g. /purchi
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/purchi?retryWrites=true&w=majority
JWT_SECRET=change-me-string
# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Fast, accurate on printed slips. The fallback is tried when the main model is busy.
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Image storage. Get this from the Cloudinary dashboard > Programs > API Keys ("API environment variable").
# Leave empty in development to store images on local disk. Set it on the server (Render etc.) so images survive restarts.
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
PORT=4000
# First admin account, created on startup when no admin exists. Login at /admin/login, then change the password there.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
